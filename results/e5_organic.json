      {
        "id": "O-2",
        "status": "dropped",
        "reason": "fewer than 20 healthy runs exist (11 in total), so E3's n = 20 operating point cannot be run"
      },
      {
        "id": "O-3",
        "text": "MS-raw-noLat's AUROC >= MS-raw's - 0.05. Stated as HOLD so it can fail. If it fails, MS-raw's organic signal is mostly latency.",
        "corpus": "organic_llama8b_cold",
        "holds_if": "AUROC(MS-raw-noLat) >= AUROC(MS-raw) - 0.05"
      },
      {
        "id": "O-4",
        "status": "untestable",
        "hypothesis_verbatim": "Hypothesis for SP8, stated before any SP8 data is seen: on a held-out family whose ESN signal is content-driven, TL-pct ranks failures above ESN_best, but it does not alarm at 5% FPR until its threshold is recalibrated (SP6). Both halves can come out wrong. The SP8 spec fixes the test and threshold before the run.",
        "source": "docs/sp5_e2_result.md section 6",
        "reason": "its premise is a held-out family whose ESN signal is content-driven; these runs are llama, whose ESN signal SP5's close-out traced to the m channel, not content (results/e2_channel_attribution.json); no new family is in the SP8 data"
      }
    ],
    "reproduction": [
      "frozen MS-raw on the llama E2 prefix rows equals results/e2_prefix_scores.csv (max abs diff <= 1e-9)",
      "ESN-src's 30 fit-draw headline AUROCs equal results/e2_closeout.json d6.subsets.aurocs (<= 1e-9)",
      "MS-raw-noLat refitted reproduces the committed fingerprint"
    ],
    "reported_only": [
      "per-t AUROC and AUROC per corpus; the T = 0.9 corpus AUROC rests on its single healthy run",
      "ESN-src as a distribution over its 30 fit draws (median, range)",
      "latency and output-token quantiles: organic healthy/failed vs llama source vs qwen source",
      "no operating point (O-2 dropped), so no any-alarm or first-crossing TPR"
    ],
    "caveat": "CI = run-level cluster bootstrap (each run its own task group); ESN draw spread = fit-set variability only",
    "not_allowed": [
